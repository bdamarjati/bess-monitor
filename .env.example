# Copy to .env and fill in. Real environment variables override this file.
MQTT_URL=tcp://127.0.0.1:1883
# Production: MQTT_URL=ssl://your.host:8883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC=bess/+/telemetry
DB_PATH=bess.db
HTTP_ADDR=127.0.0.1:8080
# Dashboard sign-in (required). Keep this file private: chmod 600 .env
DASH_USER=admin
DASH_PASS=
# Optional: a long random string keeps users signed in across restarts.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
# Retention per data tier, in days
RETENTION_RAW_DAYS=7
RETENTION_1M_DAYS=90
RETENTION_1H_DAYS=1825
